ARG MODEL_IMAGE=spamclassifier0725.azurecr.io/spam-model:advanced-v2-20260813-200127
FROM ${MODEL_IMAGE} AS model_artifacts

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    MODEL_BACKEND=advanced \
    ADVANCED_ARTIFACT_DIR=/app/artifacts/advanced-v2

WORKDIR /app

COPY requirements.txt requirements-v2.txt ./
RUN pip install --no-cache-dir -r requirements-v2.txt

COPY app ./app
COPY src ./src
COPY --from=model_artifacts /artifacts/advanced-v2 ./artifacts/advanced-v2

EXPOSE 8000

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
